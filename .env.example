# ClassBridge AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ── MongoDB ────────────────────────────────────────────────────────────
# Production connection string (e.g. MongoDB Atlas or authenticated local)
MONGODB_URI=mongodb://localhost:27017/

# ── File Upload (optional — defaults to ~/classbridge/uploads/recordings)
# UPLOAD_DIR=C:/your/custom/path/uploads/recordings
# AUDIO_DIR=C:/your/custom/path/uploads/audio

# ── Server (optional — default is 8080)
# SERVER_PORT=8080

# ── JWT (REQUIRED for production — must be at least 32 characters) ─────
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_AT_LEAST_32_CHARS

# ── Transcription Service (optional — default is http://localhost:5000)
# TRANSCRIPTION_URL=http://localhost:5000

# ── Gemini AI (REQUIRED for AI features) ──────────────────────────────
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
